# Copy to .env.local and fill in your Anthropic API key.
# Get one at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the default model. Defaults to claude-sonnet-4-5.
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional: site URL used for OpenGraph metadataBase + absolute URLs.
# NEXT_PUBLIC_SITE_URL=https://your-deploy.vercel.app

# Optional: Upstash Redis REST credentials for /api/chat rate limiting
# (20 requests / hour per IP). Without these the rate limiter no-ops.
# Get free creds at https://console.upstash.com/redis (REST API tab).
# UPSTASH_REDIS_REST_URL=https://...upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
